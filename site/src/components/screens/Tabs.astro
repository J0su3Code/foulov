---
// Barre des quatre onglets de l'app.
interface Props {
  active: number;
}
const { active } = Astro.props;
const tabs = [
  ['Nous', 'M12 19s-6.5-3.8-6.5-8.8A3.7 3.7 0 0 1 12 8a3.7 3.7 0 0 1 6.5 2.2c0 5-6.5 8.8-6.5 8.8z'],
  ['Messages', 'M19 11.5a7 7 0 0 1-10.2 6.2L5 19l1.2-3.7A7 7 0 1 1 19 11.5z'],
  ['Souvenirs', 'M5 6h14v12H5zM5 15l4-4 4 4 2-2 4 4'],
  ['Lettres', 'M4 6.5h16v11H4zM4.5 7.5 12 13l7.5-5.5'],
];
---

<div class="tabs" aria-hidden="true">
  {
    tabs.map(([name, d], i) => (
      <div class:list={['t', { on: i === active }]}>
        <span class="pill">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round">
            <path d={d} />
          </svg>
        </span>
        {name}
      </div>
    ))
  }
</div>

<style>
  .tabs {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    padding: 7px 6px 14px;
    background: var(--p-card);
    border-top: 1px solid var(--p-line);
  }
  .t {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 9.5px;
    color: var(--p-muted);
  }
  .pill {
    width: 44px;
    height: 24px;
    border-radius: 99px;
    display: grid;
    place-items: center;
  }
  .on {
    color: var(--p-ink);
    font-weight: 700;
  }
  .on .pill {
    background: var(--p-soft);
    color: var(--p-accent);
  }
</style>
