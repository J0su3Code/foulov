---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import Nous from '../components/screens/Nous.astro';
import Chat from '../components/screens/Chat.astro';
import { SITE } from '../site';

const spaces = [
  {
    icon: 'heart',
    name: 'Nous',
    text: 'Votre profil de couple : la photo à deux, une couverture, votre bio, vos jours ensemble. Racontez votre rencontre et retrouvez vos dates importantes, avec un rappel le jour venu.',
  },
  {
    icon: 'message',
    name: 'Messages',
    text: 'Mots doux, photos, vidéos, vocaux, réactions et réponses. Une conversation que vous habillez à votre image : thèmes, fonds animés, motifs, couleurs des bulles.',
  },
  {
    icon: 'image',
    name: 'Souvenirs',
    text: 'Tout ce que vous vous envoyez, rangé mois par mois. Des albums que vous remplissez à deux, et vos vocaux, à réécouter.',
  },
  {
    icon: 'letter',
    name: 'Lettres',
    text: 'Des lettres longues, à lire au calme. Et des capsules scellées, qui ne s’ouvrent qu’au jour que vous avez choisi.',
  },
] as const;

const seen = [
  'Votre adresse e-mail (ou votre compte Google), pour vous connecter',
  'Que vos deux comptes forment un couple, pour acheminer vos messages',
  'L’heure d’envoi et la taille arrondie des contenus chiffrés',
  'Quand l’app est ouverte et quand vous écrivez — désactivable',
];
const never = [
  'Vos messages, vos vocaux, vos réactions',
  'Vos photos, vidéos, légendes et albums',
  'Vos instants, vos lettres, vos capsules',
  'Vos prénoms, surnoms, bio, dates et anniversaires',
];
---

<Base title="FouLove">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow">Messagerie privée pour les couples</span>
        <h1>Une bulle <em>à deux.</em></h1>
        <p class="lead">
          Vos mots doux, vos photos, vos instants et vos lettres, dans un espace rien qu’à vous. Tout est chiffré sur
          votre téléphone, et ne se lit que sur celui de votre amour. Personne d’autre, pas même nous.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="/guide/">Découvrir l’app <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="/securite/"><Icon name="shield" /> Comment c’est protégé</a>
        </div>
        <ul class="proofs" aria-label="En bref">
          <li><Icon name="lock" size={18} /> Chiffré de bout en bout</li>
          <li><Icon name="ban" size={18} /> Sans publicité ni traceur</li>
          <li><Icon name="code" size={18} /> Code public</li>
        </ul>
      </div>
      <div class="hero-art">
        <div class="glow" aria-hidden="true"></div>
        <Phone label="L’écran Nous de FouLove : photo de couple, jours ensemble, instants et prochaine date" class="p1">
          <Nous />
        </Phone>
        <Phone label="L’écran Messages : une conversation avec photos, vocal et réactions" class="p2">
          <Chat />
        </Phone>
      </div>
    </div>
  </section>

  <section class="section" id="app">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">L’app</span>
        <h2>Quatre espaces, une seule bulle</h2>
        <p class="lead">
          FouLove n’est pas un réseau social. Il n’y a ni fil, ni abonnés, ni inconnus : seulement vous deux, et ce que
          vous construisez ensemble.
        </p>
      </div>
      <div class="grid grid-4">
        {
          spaces.map((s) => (
            <article class="card space">
              <div class="icon-badge">
                <Icon name={s.icon} />
              </div>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
      <div class="extras">
        <div>
          <Icon name="sparkles" />
          <p><strong>Instants.</strong> Une photo, une vidéo ou un mot, visible 24 heures, pour vous deux seulement.</p>
        </div>
        <div>
          <Icon name="palette" />
          <p><strong>Personnalisation.</strong> 8 thèmes, des dégradés qui bougent doucement, 7 motifs, votre photo en fond.</p>
        </div>
        <div>
          <Icon name="sun" />
          <p><strong>Jour et nuit.</strong> Crème et framboise le jour, prune profonde la nuit. Ou au rythme du téléphone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div>
        <span class="eyebrow">À distance comme à côté</span>
        <h2>Invitez votre amour, même à des milliers de kilomètres</h2>
        <p>
          Beaucoup de couples vivent loin l’un de l’autre. Pour créer votre bulle, il suffit d’envoyer l’invitation par
          la messagerie que vous utilisez déjà. Ou, si vous êtes ensemble, de scanner un QR code.
        </p>
        <p>
          Dans les deux cas, vos téléphones vérifient tout seuls qu’ils parlent bien l’un à l’autre, et à personne
          d’autre. Il n’y a rien à comparer : collez l’invitation ou scannez le QR code, c’est tout.
        </p>
        <a href="/guide/#inviter-votre-amour">Voir comment inviter, pas à pas <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="steps" aria-label="Les trois étapes de l’invitation">
        <li>
          <span class="n">1</span>
          <div><strong>Créez votre bulle</strong><p>Connectez-vous avec Google ou un code reçu par e-mail.</p></div>
        </li>
        <li>
          <span class="n">2</span>
          <div><strong>Envoyez l’invitation</strong><p>Par WhatsApp, SMS ou e-mail. Elle est valable 24 heures, une seule fois.</p></div>
        </li>
        <li>
          <span class="n">3</span>
          <div><strong>Votre bulle est née</strong><p>Les clés sont vérifiées. Tout ce que vous partagez est désormais chiffré.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Transparence</span>
        <h2>Ce que nos serveurs voient. Et ce qu’ils ne verront jamais.</h2>
        <p class="lead">
          Une messagerie ne peut pas tout cacher : pour acheminer un message, il faut savoir à qui il va. Voici,
          sans détour, ce que nous voyons.
        </p>
      </div>
      <div class="grid grid-2">
        <div class="card list">
          <h3><Icon name="eye" /> Ce que nous voyons</h3>
          <ul>{seen.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="card list never">
          <h3><Icon name="eyeOff" /> Ce que nous ne voyons jamais</h3>
          <ul>{never.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
      <p class="more"><a href="/confidentialite/">La politique de confidentialité complète <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Nos engagements</span>
        <h2>Des promesses que l’on peut vérifier</h2>
      </div>
      <div class="grid grid-3 promises">
        <div>
          <div class="icon-badge"><Icon name="ban" /></div>
          <h3>Aucune publicité, aucun traceur</h3>
          <p>Ni dans l’app, ni sur ce site. Nous ne vendons rien sur vous, et nous ne mesurons pas vos visites.</p>
        </div>
        <div>
          <div class="icon-badge"><Icon name="phone" /></div>
          <h3>Ni numéro, ni carnet d’adresses</h3>
          <p>FouLove ne demande pas votre numéro de téléphone et n’accède pas à vos contacts, ni à votre position.</p>
        </div>
        <div>
          <div class="icon-badge"><Icon name="code" /></div>
          <h3>Un code ouvert à tous</h3>
          <p>
            Tout le code de FouLove est public, sous licence AGPL-3.0. Chacun peut vérifier ce que l’app fait vraiment.
          </p>
        </div>
        <div>
          <div class="icon-badge"><Icon name="key" /></div>
          <h3>Vos clés restent chez vous</h3>
          <p>Elles sont créées sur votre téléphone et n’en sortent jamais. Nous ne pouvons rien déchiffrer.</p>
        </div>
        <div>
          <div class="icon-badge"><Icon name="trash" /></div>
          <h3>Tout effacer, quand vous voulez</h3>
          <p>
            Fermer votre bulle ou supprimer votre compte, dans l’app ou <a href="/supprimer-mon-compte/">depuis ce site</a>.
            Le contenu est effacé de nos serveurs.
          </p>
        </div>
        <div>
          <div class="icon-badge"><Icon name="shield" /></div>
          <h3>Des outils éprouvés</h3>
          <p>
            Le protocole Signal, avec protection post-quantique, et des bibliothèques reconnues. Rien d’inventé.
          </p>
        </div>
      </div>
      <div class="note note-warn honest">
        <p>
          <strong>Ce que nous ne dirons pas.</strong> FouLove n’a pas encore fait l’objet d’un audit de sécurité
          indépendant. Tant que ce n’est pas le cas, nous ne prétendrons pas être « plus sûrs que » qui que ce soit.
          Nous publions notre conception, nos limites et notre code : <a href="/securite/">tout est expliqué ici</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Bon à savoir</h2>
      </div>
      <div class="faq">
        <details>
          <summary>Est-ce que FouLove est gratuite ?</summary>
          <p>Oui. Il n’y a ni publicité, ni abonnement, ni achat dans l’app.</p>
        </details>
        <details>
          <summary>Et si je change de téléphone ?</summary>
          <p>
            Deux solutions. Votre sauvegarde chiffrée, avec votre phrase de 24 mots. Ou, plus simple, la récupération
            depuis le téléphone de votre amour : il accepte sur son écran, et votre historique revient. <a href="/guide/#changer-de-téléphone">Voir comment</a>.
          </p>
        </details>
        <details>
          <summary>Et si nous perdons nos deux téléphones ?</summary>
          <p>
            Sans votre phrase de 24 mots, vos échanges sont perdus. Personne ne peut les récupérer, pas même nous :
            c’est le prix d’une vraie confidentialité. Gardez votre phrase en lieu sûr.
          </p>
        </details>
        <details>
          <summary>FouLove existe-t-elle sur iPhone ?</summary>
          <p>Pas encore. Android d’abord, l’iPhone ensuite.</p>
        </details>
        <details>
          <summary>Puis-je l’utiliser avec plusieurs personnes ?</summary>
          <p>
            Non. Une bulle réunit exactement deux personnes. Il n’y a pas de groupes, pas de recherche de profils, pas
            de mise en relation avec des inconnus.
          </p>
        </details>
        <details>
          <summary>À partir de quel âge ?</summary>
          <p>FouLove s’adresse aux personnes de 16 ans et plus. <a href="/securite-enfants/">Notre politique</a>.</p>
        </details>
      </div>
      <p class="more"><a href="/aide/">Toutes les questions et le contact <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="final">
    <div class="wrap final-inner">
      <img src="/icone-192.png" width="88" height="88" alt="" class="final-icon" />
      <h2>Bientôt sur Google Play</h2>
      <p class="lead">
        FouLove arrive d’abord sur Android, puis sur iPhone. En attendant, le guide vous montre tout, écran par écran.
      </p>
      <div class="ctas center">
        <a class="btn btn-primary" href="/guide/"><Icon name="book" /> Lire le guide</a>
        <a class="btn btn-ghost" href={`mailto:${SITE.email}`}><Icon name="mail" /> Nous écrire</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 104px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
  }
  h1 em {
    font-style: italic;
    color: var(--accent-ink);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 30px 0 26px;
  }
  .ctas.center {
    justify-content: center;
  }
  .proofs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .proofs li {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .proofs :global(svg) {
    color: var(--accent-ink);
  }
  .hero-art {
    position: relative;
    height: 640px;
  }
  .glow {
    position: absolute;
    inset: 6% 0 0 8%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--accent) 26%, transparent), transparent),
      radial-gradient(closest-side at 70% 70%, color-mix(in srgb, var(--gold) 26%, transparent), transparent);
    filter: blur(20px);
  }
  .hero-art :global(.p1) {
    position: absolute;
    left: 4%;
    top: 0;
    z-index: 2;
    transform: rotate(-4deg);
  }
  .hero-art :global(.p2) {
    position: absolute;
    right: 0;
    top: 52px;
    transform: rotate(5deg);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      height: 560px;
      max-width: 560px;
      width: 100%;
      margin: 0 auto;
    }
  }
  @media (max-width: 600px) {
    .hero-art {
      height: auto;
      display: flex;
      justify-content: center;
      padding: 10px 0 0;
    }
    .hero-art :global(.p1) {
      position: relative;
      left: auto;
      transform: none;
      width: min(290px, 78vw);
    }
    .hero-art :global(.p2) {
      display: none;
    }
  }
  .space p {
    color: var(--muted);
    margin: 0;
  }
  .extras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 28px;
  }
  .extras > div {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 4px 4px;
  }
  .extras :global(svg) {
    color: var(--accent-ink);
    flex: none;
    margin-top: 3px;
  }
  .extras p {
    margin: 0;
    color: var(--muted);
  }
  .extras strong {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .extras {
      grid-template-columns: 1fr;
    }
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .split a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .steps li {
    display: flex;
    gap: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 20px;
    box-shadow: var(--shadow);
  }
  .steps p {
    margin: 2px 0 0;
    color: var(--muted);
  }
  .n {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-family: var(--serif);
  }
  .list h3 {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .list h3 :global(svg) {
    color: var(--muted);
  }
  .never h3 :global(svg) {
    color: var(--accent-ink);
  }
  .list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    padding: 10px 0 10px 28px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 19px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--muted);
  }
  .never {
    background: linear-gradient(160deg, var(--soft), var(--card) 70%);
  }
  .never li::before {
    border: 0;
    background: var(--accent);
  }
  .more {
    margin: 26px 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .promises {
    gap: 36px 32px;
  }
  .promises p {
    color: var(--muted);
    margin: 0;
  }
  .honest {
    margin-top: 44px;
    background: var(--card);
  }
  .faq {
    max-width: 820px;
    border-top: 1px solid var(--line);
  }
  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 40px 20px 0;
    font-weight: 700;
    font-size: 1.1rem;
    position: relative;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '';
    position: absolute;
    right: 8px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--accent-ink);
    border-bottom: 2px solid var(--accent-ink);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.2s;
  }
  .faq details[open] summary::after {
    transform: translateY(-30%) rotate(225deg);
  }
  .faq p {
    color: var(--muted);
    padding-right: 40px;
  }
  .final {
    padding: clamp(64px, 9vw, 112px) 0;
    background:
      radial-gradient(50% 80% at 50% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent),
      var(--bg);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .final-inner .lead {
    margin: 0 auto;
  }
  .final-icon {
    margin: 0 auto 22px;
    border-radius: 22px;
    box-shadow: var(--shadow);
  }
</style>
